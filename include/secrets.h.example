#pragma once

// Wi-Fi の接続先。{"表示名", "SSID", "パスワード"} を並べる。表示名は一覧のボタンに出る。
// 起動時に一覧が出て、タッチで選ぶまで待つ。近くで見つからない接続先は灰色で「圏外」と出る。
// 一覧の最後には「オフライン」が出て、選ぶと Wi-Fi なしで進む。
// 一覧に出るのは先頭の4件まで。
#define WIFI_NETWORKS { \
    {"自宅",     "your-ssid",   "your-password"}, \
    {"オフィス", "your-ssid-2", "your-password-2"}, \
}

// さくらのAI Engine のアカウントトークン
#define SAKURA_AI_TOKEN "your-token"
